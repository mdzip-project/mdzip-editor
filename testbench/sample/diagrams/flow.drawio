<mxfile host="Electron" type="device">
  <diagram id="editing-flow" name="Editing flow">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="you" value="You&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;MDZip editor in VS Code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#1c1c1e;fontColor=#1c1c1e;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="AI agent&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;MDZip MCP tools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#1c1c1e;fontColor=#1c1c1e;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="40" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="archive" value="my-archive.mdz" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#1c1c1e;strokeColor=#1c1c1e;fontColor=#ffffff;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="230" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="save" value="Save&lt;br&gt;(checks the file first)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#1c1c1e;fontColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="you" target="archive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="write" value="mdz_write_entry&lt;br&gt;(needs the entry hash)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#1c1c1e;fontColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="archive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="reload" value="Reloads, or asks if you&lt;br&gt;have unsaved edits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;strokeColor=#9a9a9a;fontColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="archive" target="you">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Either side's change is refused if the file changed since it was last read, so neither silently overwrites the other." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontColor=#555555;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="150" y="330" width="400" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
