{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "useDefineForClassFields": false,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "mdzip-editor": ["./packages/editor/src/index.ts"],
      "@mdzip/editor-ng": ["./packages/editor-ng/src/public-api.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
