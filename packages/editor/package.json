{
  "name": "@mdzip/editor",
  "version": "1.3.21",
  "description": "Framework-independent MDZip workspace engine.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdzip-project/mdzip-editor.git",
    "directory": "packages/editor"
  },
  "homepage": "https://mdzip.org",
  "bugs": {
    "url": "https://github.com/mdzip-project/mdzip-editor/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./diff-view": {
      "types": "./dist/diff-view.d.ts",
      "import": "./dist/diff-view.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.js"
    },
    "./mdz-archive.worker.js": "./dist/mdz-archive.worker.js"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:library-info": "node scripts/generate-library-info.mjs",
    "prebuild": "npm run generate:icons && npm run generate:library-info",
    "build": "tsc -p tsconfig.json && npm run build:worker",
    "build:worker": "esbuild src/mdz-archive.worker.ts --bundle --outfile=dist/mdz-archive.worker.js --format=esm --platform=browser",
    "test": "npm run build && node --test tests/*.test.mjs && vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.37.2",
    "@lezer/highlight": "^1.2.1",
    "@mdzip/core-js": "file:../../../mdzip-core-js/mdzip-core-js-1.4.0.tgz",
    "dompurify": "^3.2.0",
    "highlight.js": "^11.10.0",
    "lucide": "^1.17.0",
    "marked": "^15.0.12"
  },
  "peerDependencies": {
    "mermaid": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "mermaid": "^11.0.0"
  }
}
