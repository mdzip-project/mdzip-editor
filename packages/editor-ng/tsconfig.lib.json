{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "paths": {
      "@mdzip/editor": ["../editor/dist/index.d.ts"],
      "@mdzip/editor/diff-view": ["../editor/dist/diff-view.d.ts"]
    },
    "types": []
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "compilationMode": "partial"
  },
  "exclude": ["**/*.spec.ts"],
  "include": ["src/**/*.ts"]
}
