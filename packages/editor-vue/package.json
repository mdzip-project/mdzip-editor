{
  "name": "@mdzip/editor-vue",
  "version": "1.3.15",
  "description": "Vue wrapper for the MDZip workspace editor.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdzip-project/mdzip-editor.git",
    "directory": "packages/editor-vue"
  },
  "homepage": "https://mdzip.org",
  "bugs": {
    "url": "https://github.com/mdzip-project/mdzip-editor/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diff-view": {
      "types": "./dist/diff-view.d.ts",
      "import": "./dist/diff-view.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:package-info": "node ../../scripts/generate-package-info.mjs",
    "prebuild": "npm run generate:package-info",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdzip/editor": "^1.3.12"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
